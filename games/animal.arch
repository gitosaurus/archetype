# The ANIMAL game in Archetype.  A neat demo!  The ability to save total
# object state in Archetype is used to painlessly and transparently save
# the question/answer database.  Because of this, the initial database is
# stored directly within the code!  Showcases some unusual features
# of Archetype.
#
# Author:  DTJ  11/26/94
#
# Rewritten as an update loop, 8/3/2026.  The 1994 original ran the whole
# session inside one 'START' and asked for a filename to save to; it is kept
# as animal_classic.arch.  A driver that takes one turn at a time -- the
# browser, or --update -- can only dispatch 'UPDATE', and autosave has since
# made the file prompts unnecessary.  Dropping them also drops the one thing
# in here that a replayed turn could not safely repeat: 'SAVE STATE' writes a
# file, which is a side effect outside the universe and therefore outside
# what a rolled-back turn can undo.

null main

  branch      : UNDEFINED
  alternative : UNDEFINED
  key_pressed : UNDEFINED
  response    : UNDEFINED

methods

  'AFFIRM' : {
    response := ( ((key_pressed := key) leftfrom 1) within "yY" )
    write key_pressed
    response
    }

  # One round of the game per turn.  Nothing is handed to the turn to consume:
  # animal has no vocabulary to command, so a driver starts it empty and it
  # stops here, at its own prompt.  'key' rather than 'read' because being
  # ready is a keystroke question; a page sends Return as a space, so that
  # answers it too.  The keystroke is written out because nothing echoes it --
  # ConsoleInput reads keys raw -- which is what 'AFFIRM' has always done.
  'UPDATE' : {
    writes "Think of an animal; hit any key when you're ready. "
    write key
    'PLAY'
    writes "Another game [y/n] ? "
    if not 'AFFIRM' -> main then
      stop "Thanks for playing."
    }

  # Playing at a console is the same loop, driven from the inside.  This is
  # the shape games/intrptr.arch uses, and the reason a game written this way
  # runs unchanged under --source, --update and the browser.
  'START' : {
    while TRUE do { 'UPDATE' }
    }

  'PLAY' : {
    branch := beginning
    while alternative := 'QUESTION' -> branch do
      branch := alternative
    write "You were thinking of... ", 'ANSWER' -> branch, "!"
    writes "Am I right? "
    if 'AFFIRM' -> main then
      write "I knew it!"
    else
      'EXTEND' -> branch
    }

end

class question based on null

  IfYes : UNDEFINED
  IfNo  : UNDEFINED
  Q     : UNDEFINED
  A     : UNDEFINED

methods

  'QUESTION' :
    if Q then {
      writes Q & " "
      if 'AFFIRM' -> main then IfYes else IfNo
    }

  'ANSWER'   : A

  'EXTEND'   : {
    create question named IfYes
    writes "What were you thinking of? "
    IfYes.A := read
    write "What question could I ask to distinguish \"", A, "\" from \"",
            IfYes.A, "\" ? "
    Q := read
    create question named IfNo
    IfNo.A := A
    writes "So if I ask \"", Q, "\", the right answer is \"", IfYes.A, "\" ? "
    if not 'AFFIRM' -> main then {
      A := IfNo.A
      IfNo.A := IfYes.A
      IfYes.A := A
    }
    A := UNDEFINED
  }

end

# To get things started:  one question with a yes and no answer
question beginning

  IfYes : whale
  IfNo  : dog
  Q     : "Does it live in the water?"

end

question whale          A : "a whale"       end
question dog            A : "a dog"         end
